# ============================================================
# AI Language Translator — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#
# TRANSLATION_PROVIDER
#   "mymemory"  — Free, no API key needed (default, 5 000 chars/day)
#   "google"    — Google Cloud Translation API (requires API key)
# ============================================================

PORT=3000
TRANSLATION_PROVIDER=mymemory

# --- Google Cloud Translation API (optional) ----------------
# Get a key at https://console.cloud.google.com/apis/credentials
# Enable "Cloud Translation API" in your GCP project first.
GOOGLE_TRANSLATE_API_KEY=

# --- MyMemory API (optional) --------------------------------
# A valid email raises the free daily limit to 10 000 chars.
MYMEMORY_EMAIL=
